{
  "rule_sets": [
    {
      "rule_set_id": "email-health-draft",
      "version": "1.0.0-draft",
      "status": "draft",
      "effective_at": "2026-09-01T00:00:00Z",
      "source": "Synthetic rules based on discovery; not approved production policy",
      "rules": [
        {"rule_id": "campaign-consent", "subject_type": "campaign", "observation": "consent_protection", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Campaign consent protection is not confirmed.", "expected_boolean": true},
        {"rule_id": "campaign-suppression", "subject_type": "campaign", "observation": "suppression_protection", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Campaign suppression or opt-out protection is invalid.", "expected_boolean": true},
        {"rule_id": "campaign-coupon", "subject_type": "campaign", "observation": "coupon_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Campaign coupon evidence is invalid.", "expected_boolean": true},
        {"rule_id": "campaign-timezone", "subject_type": "campaign", "observation": "timezone_match", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Campaign schedule does not match the account timezone.", "expected_boolean": true},
        {"rule_id": "campaign-utm", "subject_type": "campaign", "observation": "utm_present", "operator": "is_true", "severity": "warning", "failure_classification": "warning", "recommendation": "correct_configuration", "description": "Campaign UTM evidence is missing.", "expected_boolean": true},
        {"rule_id": "campaign-links", "subject_type": "campaign", "observation": "links_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "One or more campaign links are invalid.", "expected_boolean": true},
        {"rule_id": "campaign-smart-sending", "subject_type": "campaign", "observation": "smart_sending_enabled", "operator": "is_true", "severity": "warning", "failure_classification": "warning", "recommendation": "correct_configuration", "description": "Smart Sending is not confirmed for this synthetic policy.", "expected_boolean": true},
        {"rule_id": "campaign-naming", "subject_type": "campaign", "observation": "naming_valid", "operator": "is_true", "severity": "warning", "failure_classification": "warning", "recommendation": "correct_configuration", "description": "Campaign naming does not match the versioned convention.", "expected_boolean": true},
        {"rule_id": "campaign-preview", "subject_type": "campaign", "observation": "preview_available", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Required mobile and desktop preview evidence is unavailable.", "expected_boolean": true},
        {"rule_id": "metric-identity", "subject_type": "metric", "observation": "metric_identity_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "data_health_exception", "recommendation": "investigate_source", "description": "Metric identity is not resolved by account, integration and metric ID.", "expected_boolean": true},
        {"rule_id": "account-order-event", "subject_type": "account", "observation": "order_event_available", "operator": "is_true", "severity": "blocking", "failure_classification": "data_health_exception", "recommendation": "investigate_source", "description": "The order event is unavailable; zero revenue cannot be interpreted as business performance.", "expected_boolean": true},
        {"rule_id": "account-report-reconciled", "subject_type": "account", "observation": "report_reconciled", "operator": "is_true", "severity": "blocking", "failure_classification": "data_health_exception", "recommendation": "investigate_source", "description": "The aggregate Email report is not reconciled.", "expected_boolean": true},
        {"rule_id": "account-bounce", "subject_type": "account", "observation": "bounce_rate", "operator": "lt", "severity": "warning", "failure_classification": "warning", "recommendation": "review_deliverability", "description": "Bounce rate exceeds the synthetic owner-provided draft threshold.", "threshold_decimal": "0.02", "sample_observation": "delivered_count", "minimum_sample": "1000"},
        {"rule_id": "account-spam-complaint", "subject_type": "account", "observation": "spam_complaint_rate", "operator": "lt", "severity": "warning", "failure_classification": "warning", "recommendation": "review_deliverability", "description": "Spam complaint rate exceeds the synthetic owner-provided draft threshold.", "threshold_decimal": "0.0008", "sample_observation": "delivered_count", "minimum_sample": "1000"},
        {"rule_id": "account-native-deliverability-alert", "subject_type": "account", "observation": "deliverability_alert_present", "operator": "is_false", "severity": "warning", "failure_classification": "warning", "recommendation": "review_deliverability", "description": "The native provider has an active deliverability alert.", "expected_boolean": false},
        {"rule_id": "flow-active", "subject_type": "flow", "observation": "flow_active", "operator": "is_true", "severity": "blocking", "failure_classification": "data_health_exception", "recommendation": "investigate_source", "description": "Flow activity is not healthy for the evaluated evidence window.", "expected_boolean": true},
        {"rule_id": "flow-metric-identity", "subject_type": "flow", "observation": "metric_identity_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "data_health_exception", "recommendation": "investigate_source", "description": "Flow trigger metric identity is invalid.", "expected_boolean": true},
        {"rule_id": "flow-filter", "subject_type": "flow", "observation": "flow_filter_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Flow filter evidence is invalid.", "expected_boolean": true},
        {"rule_id": "flow-stop-condition", "subject_type": "flow", "observation": "stop_condition_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Flow stop-condition evidence is invalid.", "expected_boolean": true},
        {"rule_id": "flow-reentry", "subject_type": "flow", "observation": "reentry_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Flow re-entry evidence is invalid.", "expected_boolean": true},
        {"rule_id": "flow-collection-property", "subject_type": "flow", "observation": "collection_property_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Flow collection property is not linked to the expected Shopify source.", "expected_boolean": true},
        {"rule_id": "form-list-mapping", "subject_type": "form", "observation": "form_list_mapping_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Form submissions are not mapped to the expected list.", "expected_boolean": true},
        {"rule_id": "coupon-valid", "subject_type": "coupon", "observation": "coupon_valid", "operator": "is_true", "severity": "blocking", "failure_classification": "blocked", "recommendation": "correct_configuration", "description": "Coupon source, validity or expiry evidence is invalid.", "expected_boolean": true}
      ]
    }
  ],
