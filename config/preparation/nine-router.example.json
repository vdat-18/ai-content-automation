{
  "name": "creative-preparation-pilot@1",
  "backend": "baml",
  "model": "xai/grok-4-fast-reasoning",
  "base_url": "http://router.example.com:20128/v1",
  "api_key_env": "ROUTER_API_KEY",
  "persona_prompt": "../prompts/creative/v1_resolve_persona.json",
  "idea_prompt": "../prompts/creative/v1_prepare_ideas.json",
  "idea_critique_prompt": "../prompts/creative/v1_critique_ideas.json",
  "brief_prompt": "../prompts/creative/v1_prepare_brief.json",
  "brief_review_prompt": "../prompts/creative/v1_review_brief.json",
  "composition_prompt": "../prompts/creative/v1_plan_static_composition.json",
  "max_ideas": 1,
  "max_brief_revisions": 1,
  "step_timeout_seconds": 90,
  "run_timeout_seconds": 480,
  "max_attempts": 3,
  "retry_delay_seconds": 1,
  "probe_on_startup": true,
  "max_context_bytes": null,
  "selection_rule_version": "m1-strategy-selection@1-draft",
  "reasoning_effort": "medium",
  "temperature": 0,
  "max_output_tokens": 12000
}
