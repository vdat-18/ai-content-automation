{
  "name": "nine-router-video",
  "backend": "openai_compatible",
  "model": "xai/grok-imagine-video-1.5",
  "model_revision": "provider-managed",
  "runtime_version": "nine-router-videos-api-v1",
  "base_url": "http://router.example.com:20128/v1",
  "api_key_env": "ROUTER_API_KEY",
  "request_timeout_seconds": 30,
  "generation_timeout_seconds": 900,
  "poll_interval_seconds": 5,
  "max_video_bytes": 200000000,
  "supported_seconds": [
    4,
    6,
    8
  ],
  "supported_sizes": [
    "1280x720",
    "720x1280"
  ],
  "default_quality": "standard"
}
