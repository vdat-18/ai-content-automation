{
  "name": "gemini-direct-static-review-shadow",
  "backend": "baml",
  "mode": "shadow",
  "model": "gemini-2.5-flash",
  "model_revision": "provider-managed",
  "runtime_version": "gemini-direct-openai-generic-vision",
  "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
  "api_key_env": "GEMINI_API_KEY",
  "prompt": "../prompts/creative/v1_review_static.json",
  "rubric": "../rubrics/creative/v1_qa_checklist.yaml",
  "criterion_ids": [
    "product_fidelity",
    "fact_and_claim_accuracy",
    "required_copy_accuracy",
    "brief_alignment",
    "product_salience",
    "visual_hierarchy_and_readability",
    "composition_and_reference_fit",
    "persona_and_brand_fit",
    "visual_naturalness",
    "conversion_clarity"
  ],
  "request_timeout_seconds": 120,
  "max_criteria_per_request": 3,
  "max_image_bytes": 10000000,
  "max_total_image_bytes": 25000000,
  "max_product_images": 5,
  "max_reference_images": 3
}

