# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
AIC_POSTGRES_DB=ai_content
AIC_POSTGRES_USER=ai_content
AIC_POSTGRES_PASSWORD=
AIC_RABBITMQ_USER=ai_content
AIC_RABBITMQ_PASSWORD=
AIC_AI_S3_ACCESS_KEY=
AIC_AI_S3_SECRET_KEY=

# Local bindings
AIC_POSTGRES_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_SEAWEED_S3_PORT=8333

# --- Brief & Ideas Preparation (BAML) ---
AIC_PREP_BASE_URL=https://api.x.ai/v1
AIC_PREP_API_KEY=
AIC_PREP_MODEL=xai/grok-4-fast-reasoning

# --- Creative Orchestration (BAML) ---
AIC_ORCH_BASE_URL=https://api.x.ai/v1
AIC_ORCH_API_KEY=
AIC_ORCH_MODEL=xai/grok-4-fast-reasoning

# --- Image & Video Generation ---
AIC_IMAGE_BASE_URL=https://api.x.ai/v1
AIC_IMAGE_API_KEY=
AIC_VIDEO_BASE_URL=https://api.x.ai/v1
AIC_VIDEO_API_KEY=
AIC_AI_MANAGED_MEDIA_CONFIG=/app/config/managed_media/nine-router.example.json

# --- Research Reference Screening & Navigation ---
AIC_SCREENING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AIC_SCREENING_API_KEY=
AIC_SCREENING_MODEL=gemini-3.8-flash
AIC_AI_JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=

# --- Performance Learning (Creative Feedback) ---
AIC_LEARNING_BASE_URL=https://api.x.ai/v1
AIC_LEARNING_API_KEY=
AIC_LEARNING_MODEL=xai/grok-4-fast-reasoning

# --- Data Sources & Concurrency ---
AIC_AI_DATA_SOURCES_CONFIG=/app/config/data_sources/demo.json
AIC_AI_CREATIVE_AUTOMATION_MAX_CONCURRENCY=3

# --- Optional: Full observability bindings (used only when running `just up-full`) ---
AIC_GRAFANA_BIND_ADDRESS=127.0.0.1
AIC_LANGFUSE_BIND_ADDRESS=127.0.0.1
AIC_LANGFUSE_PUBLIC_URL=http://localhost:3001
