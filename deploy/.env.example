# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
AIC_POSTGRES_DB=ai_content
AIC_POSTGRES_USER=ai_content
AIC_POSTGRES_PASSWORD=
AIC_AI_S3_ACCESS_KEY=
AIC_AI_S3_SECRET_KEY=

# Local bindings. The dashboard has no login: set AIC_HTTP_BIND_ADDRESS to 0.0.0.0 only behind
# something that asks for one (a VPN, Tailscale, Cloudflare Access or a reverse proxy with auth).
AIC_HTTP_BIND_ADDRESS=127.0.0.1
# To ask for a login instead, see deploy/nginx/auth.example.conf
# AIC_NGINX_AUTH_CONF=./nginx/auth.example.conf
# AIC_NGINX_HTPASSWD=./nginx/htpasswd
AIC_POSTGRES_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_SEAWEED_S3_PORT=8333

# --- Every LLM step (BAML, OpenAI-compatible endpoint). With no key all of them are off ---
AIC_SCREENING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AIC_SCREENING_API_KEY=
# One model per job, no fallback. Writer: brief, hooks, captions, shortening, keywords.
# Review: checks of images, keyframes, clips, storyboard, voice and reference picks.
AIC_WRITER_MODEL=
AIC_REVIEW_MODEL=

# --- Text embedding of reference descriptions (finds a reference for each shot). Empty
# URL/key reuse the image settings; an empty model turns reference matching off. ---
AIC_TEXT_EMBEDDING_BASE_URL=
AIC_TEXT_EMBEDDING_API_KEY=
AIC_TEXT_EMBEDDING_MODEL=

# --- Image generation: leave base URL and key empty to reuse the screening endpoint ---
AIC_IMAGE_BASE_URL=
AIC_IMAGE_API_KEY=
AIC_IMAGE_MODEL=
# chat = chat completions, edits = images/edits (for grok-imagine style models)
AIC_IMAGE_API=chat
# Image-to-video model (every clip is asked for 15 seconds, the model accepts 1 to 15). Empty URL/key
# fall back to the image settings.
AIC_VIDEO_BASE_URL=
AIC_VIDEO_API_KEY=
AIC_VIDEO_MODEL=
# Field(s) that carry the first frame of a clip. `image` works with the default video service; list
# more, comma separated, for a service that names it differently (e.g. image,input_reference).
AIC_VIDEO_FRAME_FIELDS=image
# Text-to-speech model for the voice-over. Empty URL/key fall back to the video settings.
AIC_TTS_BASE_URL=
AIC_TTS_API_KEY=
AIC_TTS_MODEL=
AIC_TTS_VOICE=
# Voice-over pace (1.0 = natural) and how much faster the generated clips play
AIC_TTS_SPEED=1.1
AIC_CLIP_SPEED=1.1
# Two reference images at least this similar (0.5 to 0.99, by embedding) count as the same image
AIC_DUPLICATE_SIMILARITY=0.80

# --- Local image embedding for duplicate detection (dinov3-vits16, dinov2-small, or empty to disable) ---
AIC_EMBEDDING_MODEL=dinov3-vits16

# --- Optional: Full observability bindings (used only when running `just up-full`) ---
AIC_GRAFANA_BIND_ADDRESS=127.0.0.1
AIC_LANGFUSE_BIND_ADDRESS=127.0.0.1
AIC_LANGFUSE_PUBLIC_URL=http://localhost:3001
# `just up-full` also refuses to start until these are set (choose long random values):
# AIC_GRAFANA_ADMIN_PASSWORD=
# AIC_LANGFUSE_POSTGRES_PASSWORD=
# AIC_LANGFUSE_CLICKHOUSE_PASSWORD=
# AIC_LANGFUSE_REDIS_PASSWORD=
# AIC_LANGFUSE_MINIO_ACCESS_KEY=
# AIC_LANGFUSE_MINIO_SECRET_KEY=
# AIC_LANGFUSE_ENCRYPTION_KEY=
# AIC_LANGFUSE_NEXTAUTH_SECRET=
# AIC_LANGFUSE_SALT=
# AIC_LANGFUSE_INIT_USER_NAME=
# AIC_LANGFUSE_INIT_USER_EMAIL=
# AIC_LANGFUSE_INIT_USER_PASSWORD=
# AIC_AI_LANGFUSE_PUBLIC_KEY=
# AIC_AI_LANGFUSE_SECRET_KEY=
