# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
AIC_POSTGRES_DB=ai_content
AIC_POSTGRES_USER=ai_content
AIC_POSTGRES_PASSWORD=
AIC_AI_S3_ACCESS_KEY=
AIC_AI_S3_SECRET_KEY=

# Models (synthetic by default; point to the router example profiles to use paid APIs).
AIC_AI_PREPARATION_CONFIG=/app/config/preparation/nine-router.example.json
AIC_AI_ORCHESTRATION_CONFIG=/app/config/orchestration/nine-router.example.json
AIC_AI_RESEARCH_SCREENING_CONFIG=/app/config/research_screening/nine-router.example.json
AIC_AI_JEV_API_URL=https://api.typesafe.ai/v1/systemone
AIC_AI_CREATIVE_AUTOMATION_MAX_CONCURRENCY=3
ROUTER_API_KEY=
JEV_API_KEY=

# Observability (bound to localhost only).
AIC_GRAFANA_BIND_ADDRESS=127.0.0.1
AIC_GRAFANA_ADMIN_USER=admin
AIC_GRAFANA_ADMIN_PASSWORD=
AIC_LANGFUSE_BIND_ADDRESS=127.0.0.1
AIC_LANGFUSE_PUBLIC_URL=http://localhost:3001
AIC_POSTGRES_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_BIND_ADDRESS=127.0.0.1
AIC_DEBUG_SEAWEED_S3_PORT=8333
